############################################################
# Polymarket BTC Bot - example environment file
#
# Copy to ".env" and fill in secrets:
#   cp .env.example .env
############################################################

# ----------------------------
# Polymarket API credentials
# ----------------------------

POLYMARKET_FUNDER=
POLYMARKET_PK=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# ----------------------------
# Redis (optional)
# ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2

# ----------------------------
# Logging
# ----------------------------
# Set to 1 for more Loguru output
BOT_VERBOSE=0

# ----------------------------
# Execution sizing / retries
# ----------------------------
# Market BUY USD amount (patched market orders use this)
MARKET_BUY_USD=1.0

# CLOB liquidity retries (signing + FAK post retry loops)
MARKET_ORDER_CLOB_RETRIES=4
MARKET_ORDER_CLOB_RETRY_MS=500

# ----------------------------
# Market selection (slug scan)
# ----------------------------
# 5m default:
BTC_MARKET_INTERVAL_SECONDS=300
BTC_UPDOWN_SLUG_PREFIX=btc-updown-5m
BTC_SLUG_HOURS_AHEAD=6.0
BTC_SLUG_MAX=96
GAMMA_SLUG_CHUNK=15
COINBASE_PRODUCT_ID=BTC-USD

# For 1h markets (set these instead, if your Polymarket slugs match):
# BTC_MARKET_INTERVAL_SECONDS=3600
# BTC_UPDOWN_SLUG_PREFIX=btc-updown-1h

# ----------------------------
# Strategy: two-leg threshold entry
# ----------------------------
# When a side's ASK is <= this price, place a $1 buy on that side.
# After the first side fills, the bot waits for the OTHER side to also hit this threshold.
ENTRY_TRIGGER_PRICE=0.33

# ----------------------------
# Lightweight predictor (Coinbase) + stake ladder
# ----------------------------
# Enable simple UP/DOWN predictor for the next 5m interval:
USE_LIGHTWEIGHT_PREDICTOR=1
# Order follows model UP/DOWN (default). Set PREDICTOR_CONTRARIAN=1 to fade the model.
PREDICTOR_CONTRARIAN=0
# Score threshold for log label only (strong vs weak); bot always places a bet
PREDICTOR_MIN_SCORE=0.50
# Coinbase samples in predictor window (60 × 5s poll ≈ 5 minutes)
PREDICTOR_WINDOW_SAMPLES=55
# Blend 3× 5m candles + ticks + flow + CLOB book (ensemble, no skip)
PREDICTOR_USE_5M_CANDLE=1
PREDICTOR_USE_CLOB_BOOK=1
# Legacy skip flags (off — predictor always picks UP or DOWN)
PREDICTOR_REQUIRE_TREND_ALIGN=0
PREDICTOR_REQUIRE_CANDLE_ALIGN=0
PREDICTOR_REQUIRE_VOLUME_CONFIRM=0
# Min |return| to count a 5m bar as up/down (0.00015 = 0.015%)
PREDICTOR_MIN_BAR_MOVE=0.00015
# Mean-reversion penalty on sudden moves (0 = off, was hurting accuracy)
PREDICTOR_REVERSAL_WEIGHT=0
# Poll Coinbase every N seconds to update predictor inputs
PREDICTOR_POLL_SECONDS=5
# Submit predictor trade at least N seconds *after* each 5m boundary (CLOB needs resting asks)
SUBMIT_SECONDS_AFTER_BOUNDARY=12
# Odd rounds only (1,3,5,7…): submit in the last N seconds before that round's slug opens.
SUBMIT_SECONDS_BEFORE_BOUNDARY=60
# Martingale on odd rounds: $1 → $2 → $4 → $8 → $16 → $32 (lose at cap → reset to $1).
MARTINGALE_BASE_USD=1
MARTINGALE_MAX_STAKE_USD=16
PREDICTOR_FULL_SLUGS_TO_SKIP_AFTER_SCORE=0
# Seconds to wait after round ends before starting to poll Polymarket for result
PREDICTOR_EVAL_POST_END_SEC=60
# At least this many seconds between any two predictor $1 orders (default 300 = one 5m slug)
# PREDICTOR_MIN_SUBMIT_GAP_SEC=300
# CLOB market BUY: retries when FAK has no match or HTTP is slow (optional overrides)
MARKET_ORDER_CLOB_RETRIES=8
MARKET_ORDER_CLOB_RETRY_MS=1000
# Stake ladder: 1.0 -> 2.0 -> 4.0 with STAKE_MAX_USD=4 (reset to base on win)
STAKE_BASE_USD=1.0
STAKE_MAX_USD=4.0

# ----------------------------
# Auto-redeem winning positions (live only; requires Builder API + POLYMARKET_PK)
# ----------------------------
POLYMARKET_AUTO_REDEEM=1
POLYMARKET_AUTO_REDEEM_INTERVAL_SEC=300
POLYMARKET_REDEEM_ON_WIN_DELAY_SEC=45
# POLYMARKET_BUILDER_API_KEY=
# POLYMARKET_BUILDER_SECRET=
# POLYMARKET_BUILDER_PASSPHRASE=

# ----------------------------
# Periodic restart (refresh slug window before it runs out)
# ----------------------------
BOT_PERIODIC_RESTART_MINUTES=0

# ----------------------------
# (Legacy / other strategy parameters)
# ----------------------------
MAX_POSITION_SIZE=1.0
STOP_LOSS_PCT=0.30
TAKE_PROFIT_PCT=0.20
SPIKE_THRESHOLD=0.15
DIVERGENCE_THRESHOLD=0.05
